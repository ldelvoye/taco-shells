{
  // A chord maps to a command id. Set one to null to unbind it: deleting the
  // line only lets the default through again.
  "cmd+t": "terminal.new",
  "cmd+w": "terminal.close",
  "cmd+\\": "terminal.split",
  "cmd+opt+right": "terminal.focusNextPane",
  "cmd+opt+left": "terminal.focusPreviousPane",
  "cmd+shift+]": "terminal.focusNextGroup",
  "cmd+shift+[": "terminal.focusPreviousGroup",
  "cmd+c": "terminal.copy",
  "cmd+v": "terminal.paste",
  "cmd+k": "terminal.clear",
  "cmd+backspace": "terminal.killLine",
  "cmd+b": "sidebar.toggle",
  "cmd+,": "config.openSettings",
  "cmd+shift+,": "config.openKeybindings"
}
