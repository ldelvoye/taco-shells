{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    "paths": {
      "@protocol/*": ["./src/protocol/*"],
      "@rules/*": ["./src/rules/*"],
      "@settings/*": ["./src/settings/*"],
      "@agents/*": ["./src/agents/*"],
      "@runtime/*": ["./src/runtime/*"],
      "@workspace/*": ["./src/workspace/*"],
      "@app/*": ["./src/app/*"],
      "@window/*": ["./src/window/*"],
      "@testing/*": ["./src/testing/*"]
    }
  },
  "include": [
    "src/protocol/**/*.ts",
    "src/rules/**/*.ts",
    "src/settings/**/*.ts",
    "src/agents/**/*.ts"
  ],
  "exclude": [
    "src/protocol/**/*.test.ts",
    "src/rules/**/*.test.ts",
    "src/settings/**/*.test.ts",
    "src/agents/**/*.test.ts"
  ]
}
