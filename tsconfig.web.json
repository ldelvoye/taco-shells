{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@protocol/*": ["./src/protocol/*"],
      "@rules/*": ["./src/rules/*"],
      "@settings/*": ["./src/settings/*"],
      "@agents/*": ["./src/agents/*"],
      "@runtime/*": ["./src/runtime/*"],
      "@workspace/*": ["./src/workspace/*"],
      "@app/*": ["./src/app/*"],
      "@window/*": ["./src/window/*"],
      "@testing/*": ["./src/testing/*"]
    }
  },
  "include": [
    "src/window/**/*.ts",
    "src/window/**/*.tsx",
    "src/protocol/**/*.ts",
    "src/rules/**/*.ts",
    "src/settings/**/*.ts",
    "src/agents/**/*.ts"
  ]
}
