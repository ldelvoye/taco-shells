{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "include": [
    "src/window/**/*.ts",
    "src/window/**/*.tsx",
    "src/protocol/**/*.ts",
    "src/rules/**/*.ts",
    "src/settings/**/*.ts",
    "src/agents/**/*.ts"
  ]
}
