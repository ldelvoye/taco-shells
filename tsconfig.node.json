{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "src/protocol/**/*.ts",
    "src/rules/**/*.ts",
    "src/settings/**/*.ts",
    "src/agents/**/*.ts",
    "src/runtime/**/*.ts",
    "src/workspace/**/*.ts",
    "src/app/**/*.ts",
    "src/testing/**/*.ts",
    "src/conformance/**/*.ts",
    "walls/**/*.ts",
    "e2e/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.mts",
    "vitest.e2e.config.mts"
  ]
}
