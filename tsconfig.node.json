{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/shared/**/*.json",
    "e2e/**/*.ts",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts"
  ]
}
