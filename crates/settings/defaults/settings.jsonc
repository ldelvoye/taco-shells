{
  // "system" follows macOS. "light" and "dark" pin it.
  "theme": "system",

  "fontFamily": "Menlo, Monaco, 'Courier New', monospace",
  "fontSize": 12,

  // Lines of history kept per terminal.
  "scrollback": 100000,

  // Lines per notch of the scroll wheel. VS Code calls this
  // mouseWheelScrollSensitivity.
  "scrollSensitivity": 1,

  "cursorBlink": true,

  // "block", "underline" or "bar".
  "cursorStyle": "block",

  // Reopen the terminals you had, each in its directory, when the app starts.
  "restoreOnLaunch": true,

  // How a plain shell's row is named: "folder" (the directory's name) or "path" (a short path like ~/code/taco-shells).
  "shellRowName": "folder",

  // Give Claude Code the Agent Activity panel's tools and hooks in this app's terminals. Set up turns it on.
  "agentActivity": false,

  // Ask an agent for a note in its activity log when it stops after real work without writing one.
  "askForActivityNotes": true
}
