diff --git a/src/vs/workbench/taqueria.defaults.contribution.ts b/src/vs/workbench/taqueria.defaults.contribution.ts
new file mode 100644
index 00000000..6e61d4d0
--- /dev/null
+++ b/src/vs/workbench/taqueria.defaults.contribution.ts
@@ -0,0 +1,46 @@
+/*---------------------------------------------------------------------------------------------
+ *  Taqueria's shipped defaults.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Registry } from '../platform/registry/common/platform.js';
+import { Extensions as ConfigurationExtensions, IConfigurationRegistry } from '../platform/configuration/common/configurationRegistry.js';
+
+// Defaults, not forced values: anything here is still overridable in settings.json.
+Registry.as<IConfigurationRegistry>(ConfigurationExtensions.Configuration).registerDefaultConfigurations([{
+	overrides: {
+		// The terminal list. Left rather than the default right, and never
+		// hidden: with one terminal open it would otherwise vanish.
+		'terminal.integrated.tabs.enabled': true,
+		'terminal.integrated.tabs.location': 'left',
+		'terminal.integrated.tabs.hideCondition': 'never',
+		'terminal.integrated.tabs.showDetailed': true,
+		'terminal.integrated.tabs.showActions': 'always',
+		'terminal.integrated.tabs.title': '${sequence}',
+		'terminal.integrated.defaultLocation': 'view',
+		'terminal.integrated.scrollback': 100000,
+		'terminal.integrated.enableMultiLinePasteWarning': 'never',
+		'terminal.integrated.initialHint': false,
+
+		// Creates a terminal on startup rather than waiting for a persistent
+		// session to restore.
+		'terminal.integrated.hideOnStartup': 'never',
+
+		// Chrome off. Explorer, Extensions and Search register view containers
+		// from modules the terminal depends on, so hiding the activity bar is
+		// what removes them.
+		'workbench.activityBar.location': 'hidden',
+		'workbench.statusBar.visible': false,
+		'workbench.panel.showLabels': false,
+		'workbench.tips.enabled': false,
+		'window.commandCenter': false,
+		'window.menuBarVisibility': 'compact',
+
+		// Quiet Light ships built in, so no extension is needed.
+		'window.autoDetectColorScheme': true,
+		'workbench.preferredLightColorTheme': 'Quiet Light',
+		'workbench.preferredDarkColorTheme': 'Default Dark Modern',
+
+		'update.mode': 'none',
+		'telemetry.telemetryLevel': 'off'
+	}
+}]);
