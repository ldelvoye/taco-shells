{
  "name": "taco-shells",
  "version": "0.0.0",
  "description": "A terminal manager for macOS",
  "license": "MIT",
  "author": "Lucas Delvoye",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "icon": "./branding/build-icon.sh",
    "package": "npm run build && npm run icon && electron-builder --mac dir",
    "dist": "npm run build && npm run icon && electron-builder --mac",
    "test": "vitest run",
    "e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "test:e2e": "npm run e2e && npm run install-app",
    "install-app": "npm run package && node scripts/install-app.mjs",
    "promote": "node scripts/promote.mjs",
    "typecheck": "npm run typecheck:shared && npm run typecheck:node && npm run typecheck:web",
    "typecheck:shared": "tsc --noEmit -p tsconfig.shared.json --composite false",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "node-pty": true,
    "esbuild": true,
    "electron": true
  }
}
